# Backend Dockerfile
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (need tsx for TypeScript runtime)
RUN npm ci

# Copy server source code and types
COPY server ./server
COPY tsconfig.json ./

# Expose backend port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3001/api/health || exit 1

# Start backend with tsx
CMD ["npx", "tsx", "server/index.ts"]
